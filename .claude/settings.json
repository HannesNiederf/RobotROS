{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(pkexec *)",
      "Bash(doas *)",
      "Bash(dd *)",
      "Bash(systemctl start *)",
      "Bash(systemctl stop *)",
      "Bash(systemctl restart *)",
      "Bash(systemctl reload *)",
      "Bash(systemctl enable *)",
      "Bash(systemctl disable *)",
      "Bash(systemctl kill *)",
      "Bash(systemctl poweroff *)",
      "Bash(systemctl reboot *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(poweroff *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * main*)",
      "Bash(git push * HEAD:main)",
      "Read(//dev/tty*)",
      "Read(//dev/serial/**)",
      "Read(//dev/robotros_*)",
      "Read(//dev/rplidar)",
      "Edit(//dev/tty*)",
      "Edit(//dev/serial/**)",
      "Edit(//dev/robotros_*)",
      "Edit(//dev/rplidar)"
    ],
    "ask": [
      "Bash(pio run *upload*)",
      "Bash(pio run *monitor*)",
      "Bash(platformio run *upload*)",
      "Bash(platformio run *monitor*)",
      "Bash(pio device *)",
      "Bash(platformio device *)",
      "Bash(pio test)",
      "Bash(pio test *-e drive*)",
      "Bash(pio test *-e aux*)",
      "Bash(pio test *-e all*)",
      "Bash(pio test *--environment*)",
      "Bash(avrdude *)",
      "Bash(arduino-cli *upload*)",
      "Bash(arduino-cli *monitor*)",
      "Bash(screen *)",
      "Bash(minicom *)",
      "Bash(picocom *)",
      "Bash(socat *)",
      "Bash(stty *)",
      "Bash(cu *)",
      "Bash(*miniterm*)",
      "Bash(*serial.tools*)",
      "Bash(ros2 topic pub *)",
      "Bash(ros2 service call *)",
      "Bash(ros2 action send_goal *)",
      "Bash(ros2 param set *)",
      "Bash(ros2 lifecycle set *)",
      "Bash(ros2 run robotros_bridge *)",
      "Bash(ros2 launch robotros_bringup *)",
      "Bash(*hil_smoke*)",
      "Bash(*calib_ticks*)",
      "Bash(*drive_straight*)",
      "Bash(*drive_rotate*)",
      "Bash(*pid_tune*)",
      "Bash(*deadband*)",
      "Bash(*battery_profile*)",
      "Bash(*hub_cycle*)",
      "Bash(*run_acceptance*)",
      "Bash(*lidar_align*)",
      "Bash(*lidar_sector*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)"
    ]
  }
}

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotros_description</name>
  <version>0.1.0</version>
  <description>URDF/xacro model of robotROS, geometry from robotros_bringup/config/robot.yaml (softwarespezifikation.md sections 3.2 and 4).</description>
  <!-- TODO: set the real maintainer name and e-mail address. -->
  <maintainer email="todo@example.invalid">RobotROS team</maintainer>
  <!-- TODO: the project license is not decided yet. -->
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robotros_bringup</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotros_mission</name>
  <version>0.1.0</version>
  <description>Mission layer of robotROS (softwarespezifikation.md section 9). So far: mission_manager part 1 with orders, stations and software E-stop (ADR 0007); activity_narrator and activity_view, the plain-language "now / plan" display (ADR 0004).</description>
  <!-- TODO: set the real maintainer name and e-mail address. -->
  <maintainer email="todo@example.invalid">RobotROS team</maintainer>
  <!-- TODO: the project license is not decided yet. -->
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>robotros_interfaces</exec_depend>
  <exec_depend>robotros_bringup</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
